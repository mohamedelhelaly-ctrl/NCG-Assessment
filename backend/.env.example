# Copy to .env and adjust. Never commit .env.
ENV=development
DATABASE_URL=postgresql://shop:shop@localhost:5433/shop
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=

# First admin (seeded on startup, M1)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ncg-admin-password

# Demo data (M2)
SEED_DEMO=true
# One-time: removes ALL products, brands and categories, then seeds the demo catalog.
# Only acts while the demo catalog is missing. Remove it after one start.
SEED_DEMO_RESET=false
DEMO_PASSWORD=change-me-demo

# Images (M2): local in development, r2 in production
STORAGE_BACKEND=local
PUBLIC_API_URL=http://localhost:8000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
